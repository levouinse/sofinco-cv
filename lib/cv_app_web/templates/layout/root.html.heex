<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={Phoenix.HTML.Tag.csrf_token_value()} />
    
    <!-- SEO Meta Tags -->
    <title>ANDI FARREL AL-FAIZY - Full-Stack Software Engineer</title>
    <meta name="description" content="Experienced full-stack engineer specializing in modern web technologies and scalable backend systems." />
    <meta name="author" content="ANDI FARREL AL-FAIZY" />
    
    <!-- Open Graph -->
    <meta property="og:title" content="ANDI FARREL AL-FAIZY - Full-Stack Software Engineer" />
    <meta property="og:description" content="Experienced full-stack engineer specializing in modern web technologies and scalable backend systems." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://yourdomain.com" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="ANDI FARREL AL-FAIZY - Full-Stack Software Engineer" />
    <meta name="twitter:description" content="Experienced full-stack engineer specializing in modern web technologies and scalable backend systems." />
    
    <link phx-track-static rel="stylesheet" href="/assets/app.css" />
    <script defer phx-track-static type="text/javascript" src="/assets/app.js">>
    </script>
  </head>
  <body class="min-h-full antialiased">
    <!-- Animated Background -->
    <div class="animated-bg"></div>
    
    <!-- Dark Mode Toggle -->
    <div class="fixed top-4 right-4 sm:top-6 sm:right-6 z-50">
      <button
        id="theme-toggle"
        class="rounded-xl bg-white/90 dark:bg-zinc-800/90 backdrop-blur-sm p-2.5 sm:p-3 hover:bg-white dark:hover:bg-zinc-700 transition-all duration-300 shadow-lg hover:scale-110"
        aria-label="Toggle dark mode"
      >
        <svg class="w-4 h-4 sm:w-5 sm:h-5 hidden dark:block text-zinc-100 transition-transform duration-300" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" />
        </svg>
        <svg class="w-4 h-4 sm:w-5 sm:h-5 block dark:hidden text-zinc-900 transition-transform duration-300" fill="currentColor" viewBox="0 0 20 20">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
        </svg>
      </button>
    </div>
    
    <%= @inner_content %>
  </body>
</html>
